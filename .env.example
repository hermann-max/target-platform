# Postgres connection string. On Vercel, connecting Neon from the Storage tab sets this.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/target

# First admin account, created on the first build when the database has no users.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Your Name

# Vercel Blob (file and image evidence). Creating a Blob store in Vercel sets this.
# Without it, files are saved to ./.uploads (local development only).
BLOB_READ_WRITE_TOKEN=

# Optional: Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: anyone with an email on this domain can sign in with Google and gets a Director account.
# Leave empty to allow Google sign-in only for accounts an admin has created.
GOOGLE_ALLOWED_DOMAIN=
# Public URL of the app, used for the Google redirect (e.g. https://target.vercel.app).
APP_URL=
